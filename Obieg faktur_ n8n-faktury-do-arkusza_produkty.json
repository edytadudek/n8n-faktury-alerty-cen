    {
      "parameters": {
        "jsCode": "const num = (v) => Number(String(v).replace(',', '.'));\nconst iso = (d) => { const s = String(d ?? '').trim(), m = s.match(/^(\\d{2})[./](\\d{2})[./](\\d{4})/); return m ? `${m[3]}-${m[2]}-${m[1]}` : s.slice(0, 10); };\nconst hist = $input.all().map(r => ({ ...r.json, d: iso(r.json.data_wystawienia) }));\nreturn $('DodanieKlucza').all().flatMap(({ json: p }) => {\n  const prev = hist.filter(h => h.d && h.d < iso(p.data_wystawienia) && h.nazwa?.toLowerCase().trim() === p.nazwa.toLowerCase().trim() && h['nr.fv'] !== p['nr.fv']).sort((a, b) => a.d.localeCompare(b.d)).at(-1);\n  if (!prev) return [];\n  const zmiana = (num(p.cena_netto) - num(prev.cena_netto)) / num(prev.cena_netto) * 100;\n  return zmiana > 10 ? [{ json: { nazwa: p.nazwa, nr_fv_poprzednia: prev['nr.fv'], poprzednia: num(prev.cena_netto), nr_fv_nowa: p['nr.fv'], nowa: num(p.cena_netto), zmiana_proc: +zmiana.toFixed(1) } }] : [];\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
